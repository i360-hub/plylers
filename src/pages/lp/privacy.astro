---
// Privacy policy. Required context: the GHL estimate form collects name/phone/email/
// address, calls route through GHL tracking numbers, and the site runs GA4, Google Ads,
// and Microsoft Clarity. Keep this in sync if those tools change.
import LandingLayout from '../../layouts/LandingLayout.astro';
import business from '../../data/business.json';
import landing from '../../data/landing.json';

const title = "Privacy Policy | Plyler's Tree Service";
const description = "How Plyler's Tree Service collects, uses, and protects the information you share through our website, forms, and phone calls.";
const effective = 'September 14, 2026';
---
<LandingLayout title={title} description={description} path="/lp/privacy">
  <section class="section">
    <div class="container measure privacy">
      <h1>Privacy Policy</h1>
      <p class="text-muted">Effective {effective}</p>

      <p>
        This policy explains how {business.name} ("we," "us") handles information when you visit
        plylerstreeservice.com, request an estimate, or call us.
      </p>

      <h2>Information we collect</h2>
      <ul>
        <li><strong>What you send us.</strong> When you request an estimate we collect what you enter — such as your name, phone number, email, address or ZIP code, the service you need, timing, and any photos you upload.</li>
        <li><strong>Phone calls.</strong> Calls to the numbers on this site go through a call-tracking service, which records details such as the calling number, date, time, and which page or ad led to the call.</li>
        <li><strong>Website usage.</strong> Cookies and similar technologies collect information such as pages viewed, device and browser type, approximate location, and how you arrived (for example, from a Google ad).</li>
      </ul>

      <h2>How we use it</h2>
      <ul>
        <li>To respond to your request, schedule and prepare estimates, and do the work you hire us for.</li>
        <li>To contact you about your request by phone, text message, or email.</li>
        <li>To understand how our website and advertising perform and to improve them.</li>
      </ul>

      <h2>Text messages</h2>
      <p>
        If you give us your mobile number, we may call or text you about your estimate request or job. Message
        and data rates may apply. Reply STOP to opt out of texts at any time, or HELP for help. We do not sell or
        share your mobile number or text-messaging consent with third parties for their marketing purposes.
      </p>

      <h2>Service providers we use</h2>
      <p>We share information only with providers that help us run our business, including:</p>
      <ul>
        <li><strong>HighLevel (LeadConnector)</strong> — our estimate form, customer records, call tracking, and messaging.</li>
        <li><strong>Google Analytics and Google Ads</strong> — measuring website traffic and ad performance.</li>
        <li><strong>Microsoft Clarity</strong> — understanding how visitors use our pages (for example, clicks and scrolling).</li>
      </ul>
      <p>We do not sell your personal information.</p>

      <h2>Your choices</h2>
      <ul>
        <li>You can block or delete cookies in your browser settings.</li>
        <li>You can opt out of Google Analytics with Google's browser add-on, and manage ad personalization in your Google account settings.</li>
        <li>You can ask us to update or delete the information you've sent us by contacting us below.</li>
      </ul>

      <h2>Keeping information</h2>
      <p>
        We keep customer information as long as we need it to serve you and to meet our business and legal
        obligations, then delete it.
      </p>

      <h2>Children</h2>
      <p>Our website and services are not directed to children under 13, and we don't knowingly collect their information.</p>

      <h2>Changes</h2>
      <p>If we change this policy, we'll update the effective date above.</p>

      <h2>Contact us</h2>
      <p>
        {business.name} · {business.address.locality}, {business.address.region}<br />
        Phone: <a href={`tel:${landing.phoneHref}`}>{landing.phoneDisplay}</a><br />
        Email: <a href={`mailto:${business.email}`}>{business.email}</a>
      </p>
    </div>
  </section>
</LandingLayout>

<style>
  .privacy h2 { font-size: clamp(1.35rem, 2.4vw, 1.7rem); margin-top: 2rem; }
  .privacy li { margin-bottom: 0.6rem; }
</style>
